# =====================================================
# MENTORCORE - Plantilla de configuración local
# =====================================================
# Uso recomendado:
# 1. Usa SPRING_PROFILES_ACTIVE=dev o prod segun el entorno
# 2. Sustituye los campos TU_... por los datos de tu entorno
# 3. Crea previamente una base de datos vacia con el nombre elegido
# =====================================================

spring.application.name=MentorCore

# Perfil activo (recomendado definirlo como variable de entorno)
spring.profiles.active=${SPRING_PROFILES_ACTIVE:dev}

# Servidor
server.port=8080
server.servlet.context-path=/
server.servlet.encoding.charset=UTF-8
server.servlet.encoding.force=true

# Base de datos MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/mentorcore_dev?useSSL=false&serverTimezone=Europe/Madrid&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
spring.datasource.username=TU_USUARIO_MYSQL
spring.datasource.password=TU_PASSWORD_MYSQL
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Hibernate / JPA
# Hibernate se usa como ORM, pero el esquema lo crean schema.sql y data.sql
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.sql.init.mode=always
spring.jpa.defer-datasource-initialization=true
spring.jpa.open-in-view=false

# Thymeleaf
spring.thymeleaf.cache=false
spring.thymeleaf.mode=HTML
spring.thymeleaf.encoding=UTF-8

# Subida de archivos
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=50MB
mentorcore.uploads.ruta-base=${MENTORCORE_UPLOADS_PATH:src/main/resources/static/uploads}
mentorcore.app.base-url=${MENTORCORE_APP_BASE_URL:http://localhost:8080}

# Actuator
management.endpoints.web.exposure.include=health,info

# Email (opcional en desarrollo)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=TU_EMAIL@gmail.com
spring.mail.password=TU_PASSWORD_EMAIL
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# DevTools
spring.devtools.restart.enabled=true
spring.devtools.livereload.enabled=true

# Logs
logging.level.com.mentorcore=DEBUG
logging.level.org.springframework.security=DEBUG
logging.level.org.hibernate.SQL=DEBUG
